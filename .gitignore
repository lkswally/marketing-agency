# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.pytest_tmp*/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Virtual envs
.venv/
venv/
env/

# Secrets / env
.env
.env.*
!.env.example
*.local.*
*.secret.*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# MKT runtime state (kept locally, not versioned)
# data/* catches data/<any-slug>/ (e.g. data/lexia/, data/acme/).
# Only the structural placeholder data/clients/.gitkeep is tracked.
data/*
!data/clients
!data/clients/.gitkeep
outputs/*
!outputs/.gitkeep
assets/clients/*/
!assets/clients/.gitkeep

# Logs
*.log
logs/

# Engram local cache (if any)
.engram-cache/
.pipeline/
.engram/
