# MARKETING-AGENCY-OS — environment variable names only. No values, no secrets.
# Copy to .env and fill in locally. .env is gitignored.

# Core runtime
MKT_MEMORY_BACKEND=
MKT_LOG_LEVEL=
MKT_BRIDGE_ATLAS=

# Anthropic (MKT-4B) — optional, only needed for --backend claude
ANTHROPIC_API_KEY=

# Notion sync (MKT-5B) — optional, only needed for `notion-sync --write --confirm`
NOTION_TOKEN=
NOTION_TASKS_DATABASE_ID=
NOTION_PARENT_PAGE_ID=

# Google Analytics 4 / Search Console (MKT-6D) — optional, read-only connectors
GOOGLE_APPLICATION_CREDENTIALS=

# Google Ads (MKT-6E) — optional, read-only connector
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
